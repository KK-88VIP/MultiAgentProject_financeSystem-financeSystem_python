APP_ENV=dev
DEBUG=true
PORT=8000
# 本地联调：未显式传 admin 时，仍按管理员返回权限与 filters（切勿在生产开启）
# 影响：GET /api/dashboard/filters、GET /api/auth/permissions（role/头缺省或 user 时升格）
# DEV_ASSUME_ADMIN_FOR_FILTERS=true
# 开发环境将指定登录 id 视为管理员（与 permissions / filters / ask 共用 PermissionService）
# DEV_ADMIN_USER_IDS=user_001,fe_dev_001
# APP_VERSION=0.2.0

# MySQL async URL (aiomysql)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/finance_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

LLM_API_KEY=your_api_key
LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
FEISHU_BOT_TOKEN=
API_TOKEN=
